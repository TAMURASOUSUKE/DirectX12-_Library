<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    このpropsファイル自身が置かれているフォルダをSDKルートとして使う。
    絶対パスを持たないため、SDKフォルダを移動しても使用できる。
  -->
  <PropertyGroup>
    <TSGameLibRoot>$(MSBuildThisFileDirectory)</TSGameLibRoot>
  </PropertyGroup>

  <!-- 現在のSDKはx64だけを提供する -->
  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64'">

    <ClCompile>
      <!-- TSLib.hを探すフォルダ -->
      <AdditionalIncludeDirectories>
        $(TSGameLibRoot)include\TSGameLib\Facade;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>

      <!-- std::formatなどを使用するためC++20が必要 -->
      <LanguageStandard>stdcpp20</LanguageStandard>

      <!-- 日本語コメントや文字列をUTF-8として扱いつつデバッグ機能を有効にする -->
      <AdditionalOptions>
        /utf-8 /Zc:preprocessor %(AdditionalOptions)
      </AdditionalOptions>
    </ClCompile>

    <Link>
      <!-- DebugならDebug、ReleaseならReleaseを自動選択する -->
      <AdditionalLibraryDirectories>
        $(TSGameLibRoot)lib\x64\$(Configuration);
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>

      <!-- TSGameLib本体と内部依存のDirectXTexを自動リンクする -->
      <AdditionalDependencies>
        DX12_Original_Library.lib;
        DirectXTex.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>

  </ItemDefinitionGroup>

  <!--
    DirectXTex.libが参照するPDBをリンク前に出力先へコピーする。
    SDKを別PCへ移動してもLNK4099が出ないようにする。
  -->
  <Target Name="TSGameLibCopyDirectXTexPdb"
          BeforeTargets="Link"
          Condition="'$(Platform)' == 'x64'
                  and Exists('$(TSGameLibRoot)lib\x64\$(Configuration)\DirectXTex.pdb')">

    <Copy
      SourceFiles="$(TSGameLibRoot)lib\x64\$(Configuration)\DirectXTex.pdb"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />

  </Target>

</Project>